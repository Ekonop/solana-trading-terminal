# STT Terminal — environment reference
# Copy to `.env` (next to the backend's working directory) to override
# settings. The backend reads this via dotenvy at startup, then STT_* also
# override the values in stt.toml. Precedence: defaults < stt.toml < .env/STT_*.
#
#   cp .env.example .env
#
# NEVER commit a real .env — especially never with STT_REAL_WALLET_KEY set.
# Keep secrets out of version control (backend/.gitignore ignores .env).

# --------------------------------------------------------------------------
# Global
# --------------------------------------------------------------------------

# Path to the TOML configuration the server should use. The bundle launcher
# (run.sh) sets this itself — only set it when running from source.
# STT_CONFIG=./stt.toml

# Application mode: demo | market-data | replay   (see stt.toml [application])
# STT_MODE=demo

# --------------------------------------------------------------------------
# Network
# --------------------------------------------------------------------------

# Bind address / port for the REST + WebSocket API.
# Use 0.0.0.0 to reach the API from a phone/other machine on your LAN.
STT_BIND=127.0.0.1
STT_PORT=8765

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------

# Directory for the embedded PostgreSQL data (one dir per experiment).
STT_DATA_DIR=./var/pglite

# --------------------------------------------------------------------------
# Market data
# --------------------------------------------------------------------------

# Provider: demo (deterministic, offline) | dexscreener (live read-only API)
STT_PROVIDER=demo

# Polling interval in milliseconds.
STT_REFRESH_MS=3000

# --------------------------------------------------------------------------
# Paper trading
# --------------------------------------------------------------------------

# Simulated starting balance, in SOL.
# STT_INITIAL_BALANCE_SOL=100

# --------------------------------------------------------------------------
# Logging
# --------------------------------------------------------------------------

# trace | debug | info | warn | error
STT_LOG=info

# ==========================================================================
# REAL-MODE — LIVE-CHAIN EXECUTION (High risk. Read docs/REAL_MODE.md + ADRs)
# ==========================================================================
# The real-mode path is DISARMED BY DEFAULT. To activate ALL of these must be
# true: armed=true AND dry-run=false AND a runtime POST /api/v1/real/arm with
# a written acknowledgement. The default build also refuses to sign until the
# ADR-0006 signer stub is replaced. Do not set these casually.

# Arm the live path (false = safe paper-only default).
# STT_REAL_ARMED=false

# Run the full pipeline WITHOUT broadcasting (true = safe default).
# STT_REAL_DRY_RUN=true

# Solana RPC endpoint for balance + broadcasting (e.g. Helius/QuickNode).
# STT_REAL_RPC_URL=https://api.mainnet-beta.solana.com

# Jupiter Ultra API key (from portal.jup.ag).
# STT_REAL_JUPITER_API_KEY=

# *** SECRET *** The base58 64-byte Solana wallet secret key.
# Set it here or in the runtime environment — NEVER commit it.
# STT_REAL_WALLET_KEY=

# Micro-capital budget (USD) for the single-market SOL strategy.
# STT_REAL_MICRO_USD=5
