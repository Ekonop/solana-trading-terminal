# STT backend environment — shorter companion to ../.env.example
# (do not commit secrets). The canonical, fully-commented reference lives in
# the repo root: ../.env.example  — copy THAT to `.env`.
#
# NOTE on names: the backend reads STT_DATA_DIR, STT_PROVIDER, STT_LOG (not
# the longer spellings). These match exactly what the code reads.

# Path to the TOML the server should use (bundle launcher sets this itself)
STT_CONFIG=./stt.toml

# Network
STT_BIND=127.0.0.1
STT_PORT=8765

# Data directory for the embedded PostgreSQL (one dir per experiment)
STT_DATA_DIR=./var/pglite

# Market data: "demo" (deterministic, offline) | "dexscreener" (live API)
STT_PROVIDER=demo

# Market polling interval (ms)
STT_REFRESH_MS=3000

# Logging: trace | debug | info | warn | error
STT_LOG=info

# ── Real-mode (live chain execution) — DISARMED BY DEFAULT ───────────────
# See ../.env.example and docs/REAL_MODE.md for the full set and the safety
# double-gate. Nothing here activates live trading on its own.
# STT_REAL_ARMED=false
# STT_REAL_DRY_RUN=true
# STT_REAL_RPC_URL=https://api.mainnet-beta.solana.com
# STT_REAL_JUPITER_API_KEY=
# STT_REAL_MICRO_USD=5
# STT_REAL_WALLET_KEY=   # <-- SECRET, never commit
