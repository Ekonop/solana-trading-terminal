# STT backend environment — reference values (do not commit secrets)
# Copy what you need; the backend reads STT_* to override stt.toml keys.

# Path to the TOML the server should use (bundle launcher sets this itself)
STT_CONFIG=./stt.toml

# Network
STT_BIND=127.0.0.1
STT_PORT=8765

# Data directory for the embedded PostgreSQL (one dir per experiment)
STT_DATABASE_DATA_DIRECTORY=./var/pglite

# Market data: "demo" (deterministic, offline) | "dex-screener" (live API)
STT_MARKET_DATA_PROVIDER=demo

# Logging: trace | debug | info | warn | error
STT_LOG_LEVEL=info